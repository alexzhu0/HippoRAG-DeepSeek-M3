# HippoRAG配置
# 复制此文件到.env并填入你的Deepseek API密钥

# Deepseek API密钥（必填）
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Deepseek API URL（可选，如果不是默认值）
DEEPSEEK_API_URL=https://api.deepseek.com/v1

# 让HippoRAG可以找到API密钥
OPENAI_API_KEY=您的DeepSeek_API密钥

# 其他可选配置
# HF_HOME=你的Hugging Face模型缓存目录
# CUDA_VISIBLE_DEVICES=0  # 对M3芯片无效，保留此项仅作参考
