# 复制为 .env，填写 DeepSeek 密钥；无需 OpenAI 账户或第二把密钥。
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# Apple Silicon 优先使用 MPS，不可用时自动使用 CUDA/CPU。
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MODEL=facebook/contriever
# 中文或多语言可尝试 facebook/mcontriever；切换模型应使用新索引目录。
# HIPPORAG_SAVE_DIR=outputs/my-index
# HF_HOME=/path/to/huggingface/cache

# 可选 OrcaRouter 网关；默认仍为 deepseek
LLM_PROVIDER=deepseek
ORCAROUTER_API_KEY=your_orcarouter_api_key
ORCAROUTER_API_URL=https://api.orcarouter.ai/v1
# 必须明确填写 vendor/model；可用型号和免费额度以官方模型目录为准
ORCAROUTER_MODEL=
